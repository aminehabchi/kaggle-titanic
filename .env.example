# ---------------------------------------------------------------------------
# Copy to .env and adjust to your machine:   cp .env.example .env
# .env is gitignored; this file is the template that IS committed.
# Keep paths ABSOLUTE so they resolve the same from the repo root and from
# notebook/ (a notebook's working directory is the notebook's own folder).
# ---------------------------------------------------------------------------

# Repo checkout
PROJECT_ROOT=/absolute/path/to/kaggle-titanic

# Where the Kaggle competition CSVs live (not committed - downloaded per machine)
DATA_DIR=/absolute/path/to/kaggle-titanic/data
TRAIN_CSV=/absolute/path/to/kaggle-titanic/data/train.csv
TEST_CSV=/absolute/path/to/kaggle-titanic/data/test.csv
SAMPLE_SUBMISSION_CSV=/absolute/path/to/kaggle-titanic/data/gender_submission.csv

# Outputs (created on demand, both gitignored)
MODEL_DIR=/absolute/path/to/kaggle-titanic/model
SUBMISSION_DIR=/absolute/path/to/kaggle-titanic/submissions

# Kaggle competition slug, for `kaggle competitions download -c $KAGGLE_COMPETITION`
KAGGLE_COMPETITION=titanic

# Kaggle API credentials: do NOT put the token here. Place kaggle.json at
# ~/.config/kaggle/kaggle.json (chmod 600) - it is gitignored if left in the repo.
